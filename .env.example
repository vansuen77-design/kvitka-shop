# Copy this file to .env and fill in your values.
# .env holds the secret key - never publish it anywhere.

# 1 - the site faces the internet: debug off, cookies over HTTPS only.
# 0 or no file - the usual local mode.
PUBLIC=1

# Django secret key. Generate a new one:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=put-a-long-random-string-here

# Domains the site answers on, comma-separated.
# .trycloudflare.com - temporary addresses for testing before the domain works
ALLOWED_HOSTS=kvitka.example,www.kvitka.example,.trycloudflare.com,localhost,127.0.0.1

# Public address of the site: used in e-mails, sitemap and canonical links.
# Empty on the local copy - the address from the request is used then.
SITE_URL=https://kvitka.example

# --- Telegram ---------------------------------------------------------
# New-order notifications, the admin login code and the owner's bot.
# Token from @BotFather, your id from @userinfobot. Both empty - the
# site works, nothing is sent. Details: TELEGRAM-BOT.txt
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- e-mail -----------------------------------------------------------
# Needed for "forgot password" e-mails and order confirmations.
# While EMAIL_HOST is empty, e-mails are printed to the log and not sent -
# the site keeps working. Details: EMAIL-SETUP.txt
#
# EMAIL_HOST_PASSWORD is an "app password", not the mailbox password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=yourmailbox@gmail.com
EMAIL_HOST_PASSWORD=16-letter-app-password
EMAIL_FROM=KVITKA <yourmailbox@gmail.com>

# --- admin panel ------------------------------------------------------
# /admin/ is protected by a one-time code from Telegram: password plus code.
# Works out of the box, nothing to set. Details - ADMIN-ACCESS.txt
#
# The lines below are only needed if you want it otherwise:
#
# ADMIN_GATE_ALLOW_LOCAL=0   ask for the code on the local copy as well
#                            (to test the gate)
# ADMIN_ALLOWED_IPS=91.203.10.55, 2a02:1810::/32
#                            allow only these addresses
# ADMIN_LOCAL_ONLY=1         no admin from outside at all, tunnel only
# ADMIN_TELEGRAM_GATE=0      switch the code off (not recommended)
