# Скопируйте этот файл в .env и подставьте свои значения.
# .env содержит секретный ключ — не выкладывайте его никуда.

# 1 — сайт смотрит в интернет: отладка выключена, куки только по HTTPS.
# 0 или отсутствие файла — обычный локальный режим.
PUBLIC=1

# Секретный ключ Django. Сгенерировать новый:
#   .venv\Scripts\python.exe -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=поставьте-сюда-длинную-случайную-строку

# Домены, по которым будет открываться сайт. Через запятую.
# .trycloudflare.com — временные адреса для проверки, пока домен не заработал
ALLOWED_HOSTS=kvitka.example,www.kvitka.example,.trycloudflare.com,localhost,127.0.0.1

# --- почта для восстановления пароля -------------------------------
# Нужна только ради писем «забыли пароль» из кабинета покупателя.
# Пока EMAIL_HOST пуст, письма печатаются в журнал и никуда не уходят —
# сайт при этом работает. Подробно: ПОЧТА-как-настроить.txt
#
# EMAIL_HOST_PASSWORD — это «пароль приложения», а не пароль от почты.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=вашящик@gmail.com
EMAIL_HOST_PASSWORD=пароль-приложения-16-букв
EMAIL_FROM=КВІТКА <вашящик@gmail.com>

# --- админка --------------------------------------------------------
# Вход в /admin/ защищён одноразовым кодом из Telegram: пароль плюс код.
# Работает само, ничего указывать не нужно. Подробности —
# АДМИНКА-как-заходить.txt
#
# Строки ниже нужны, только если хотите иначе:
#
# ADMIN_GATE_ALLOW_LOCAL=0   спрашивать код даже на своей копии
#                            (для проверки шлюза)
# ADMIN_ALLOWED_IPS=91.203.10.55, 2a02:1810::/32
#                            пускать только с этих адресов
# ADMIN_LOCAL_ONLY=1         админки снаружи нет вовсе, только туннель
# ADMIN_TELEGRAM_GATE=0      выключить код (не рекомендуется)
