# Daily backup at 4 am. Copy to /etc/systemd/system/
#
#   sudo systemctl enable --now kvitka-backup.timer
#   systemctl list-timers kvitka-backup     - when it fires next
#   sudo systemctl start kvitka-backup      - make a backup right now

[Unit]
Description=KVITKA daily backup

[Timer]
OnCalendar=*-*-* 04:00:00
# if the server was off at 4 am - runs right after boot
Persistent=true

[Install]
WantedBy=timers.target
