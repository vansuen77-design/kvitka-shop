# One-shot site check. Started by the timer, does nothing on its own.
# Copy to /etc/systemd/system/

[Unit]
Description=KVITKA site availability check
After=network-online.target

[Service]
Type=oneshot
User=kvitka
Group=kvitka
ExecStart=/bin/bash /home/kvitka/kvitka/deploy/monitor.sh
NoNewPrivileges=true
PrivateTmp=true
