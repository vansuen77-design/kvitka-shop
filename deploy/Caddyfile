# FALLBACK OPTION - only needed if you drop the Cloudflare tunnel and
# decide to route traffic straight to the server IP.
#
# WARNING. In that setup the admin IP check must be reworked: the
# CF-Connecting-IP header is no longer trustworthy, because the server
# becomes reachable directly and anyone can send that header.
# Then core/middleware.py must take the address from REMOTE_ADDR, and
# Caddy must pass the real client address (the X-Forwarded-For line below).
#
# Copy to /etc/caddy/Caddyfile, then: sudo systemctl reload caddy
# Caddy obtains the certificate itself, nothing to buy.

kvitka.example, www.kvitka.example {
	encode zstd gzip

	# product photos are served by Caddy itself - faster than through Django
	handle_path /media/* {
		root * /home/kvitka/kvitka/media
		file_server
	}

	reverse_proxy 127.0.0.1:8000 {
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-For {remote_host}
	}
}
