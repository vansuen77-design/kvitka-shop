# Cloudflare tunnel. Copy to /etc/systemd/system/kvitka-tunnel.service
#
# The tunnel credentials file goes to /home/kvitka/.cloudflared/
# The same one that lives in %USERPROFILE%\.cloudflared\ on your computer
#
#   sudo systemctl enable --now kvitka-tunnel
#   journalctl -u kvitka-tunnel -f

[Unit]
Description=Cloudflare Tunnel for KVITKA
After=network-online.target kvitka.service
Wants=network-online.target

[Service]
User=kvitka
Group=kvitka
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate \
    --config /home/kvitka/kvitka/deploy/cloudflared.yml run
Restart=always
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
