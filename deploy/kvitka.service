# KVITKA site. Copy to /etc/systemd/system/kvitka.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kvitka
#   sudo systemctl status kvitka
#   journalctl -u kvitka -f        - watch what is going on

[Unit]
Description=KVITKA - flower shop
After=network-online.target
Wants=network-online.target

[Service]
User=kvitka
Group=kvitka
WorkingDirectory=/home/kvitka/kvitka
Environment=PYTHONUNBUFFERED=1

# Listen on 127.0.0.1 only: the server is not exposed at all, all traffic
# arrives through the Cloudflare tunnel. That is exactly why the
# CF-Connecting-IP header can be trusted - nobody outside can forge it.
ExecStart=/home/kvitka/kvitka/.venv/bin/waitress-serve \
    --host=127.0.0.1 --port=8000 --threads=6 \
    config.wsgi:application

Restart=always
RestartSec=3

# Restrictions in case a hole is found in the site: writable only inside
# its own folder, no way to gain root from the process.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kvitka/kvitka
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
