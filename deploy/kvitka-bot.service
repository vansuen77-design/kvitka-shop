# KVITKA Telegram bot: shows orders and customers to the owner.
# Copy to /etc/systemd/system/kvitka-bot.service
#
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now kvitka-bot
#   sudo systemctl status kvitka-bot
#   journalctl -u kvitka-bot -f     - watch what is going on
#
# The bot only reads the database. It changes nothing and answers nobody
# but the owner: a foreign id is dropped silently.

[Unit]
Description=KVITKA - Telegram bot for the owner
After=network-online.target kvitka.service
Wants=network-online.target

[Service]
User=kvitka
Group=kvitka
WorkingDirectory=/home/kvitka/kvitka
Environment=PYTHONUNBUFFERED=1

ExecStart=/home/kvitka/kvitka/.venv/bin/python manage.py telegram_bot

# The bot sits on long polling: the connection drops routinely, that is
# not an error. So restart always, without hurry.
Restart=always
RestartSec=10

# Same restrictions as the site: writable only inside its own folder,
# no way to gain root from the process.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/kvitka/kvitka
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
