# Check every 5 minutes. Copy to /etc/systemd/system/
#
#   sudo systemctl enable --now kvitka-monitor.timer
#   systemctl list-timers kvitka-monitor
#   sudo systemctl start kvitka-monitor     - check right now

[Unit]
Description=Check the KVITKA site every 5 minutes

[Timer]
OnBootSec=3min
OnUnitActiveSec=5min
AccuracySec=30s

[Install]
WantedBy=timers.target
